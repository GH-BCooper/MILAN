# The offline profile — Milan with the wifi physically off (CLAUDE.md invariant 8).
#
#   cp .env.local .env.online          # keep your online values first
#   cp .env.offline.example .env.local
#   docker compose up -d
#   pnpm db:migrate && pnpm seed --reset
#   pnpm build && pnpm demo:offline
#
# Restores the online profile with:  cp .env.online .env.local
#
# Pairs with docker-compose.yml: postgres (pgvector), minio, ollama, mailpit.
# What actually gets replaced offline, honestly:
#   Supabase Postgres -> local postgres below (pgvector included)
#   Gemini / Groq     -> nothing: the chain lands on the deterministic rule
#                        tier and every stage returns at fallback level 2
#   Supabase Storage  -> NOT replaced. No local storage implementation exists
#                        yet, so photo upload degrades to "could not be stored"
#                        and the challenge is still created (declared stub)
#   Resend            -> NOT replaced. The mailer speaks Resend's HTTPS API only;
#                        with an empty key mail is logged "email: not configured".
#                        Mailpit runs in compose for when an SMTP path exists.
#   Ollama            -> running in compose, but no code reads OLLAMA_BASE_URL yet
#                        (reserved for a local provider tier)

# ---- database ----
# The docker-compose postgres. Host port 54322 maps to 5432 in the container.
DATABASE_URL=postgresql://milan:milan@localhost:54322/milan
DIRECT_URL=postgresql://milan:milan@localhost:54322/milan
# NEVER set this to 1: drizzle's postgres-js driver cannot pipeline, so two
# concurrent queries on one connection deadlock. See lib/db/index.ts.
DATABASE_POOL_MAX=8

# ---- supabase ----
# Deliberately empty offline. Everything storage-related degrades gracefully.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- auth ----
BETTER_AUTH_SECRET=offline-demo-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# ---- intelligence ----
# No provider keys: the chain appends `rules` whatever this says, and rules is
# the only tier with a value. This is the behaviour the offline demo shows.
AI_PROVIDER_CHAIN=rules
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- notifications ----
# No RESEND_API_KEY AND no MAILPIT_URL  => mail writes in-app only and the
#   result records "email: not configured" (honest, no pretend send).
# No RESEND_API_KEY BUT MAILPIT_URL set => the offline demo delivers email into
#   Mailpit's inbox at localhost:8025, so a judge sees the routing notice land
#   on screen. Mailpit runs in docker-compose (:8025 inbox, :1025 SMTP).
# RESEND_API_KEY set                    => online path via Resend (wins).
RESEND_API_KEY=
NOTIFY_FROM=milan@localhost
MAILPIT_URL=http://localhost:8025
SMS_MODE=mock                          # never anything else

# ---- map ----
# Unset is safe: markers draw on a blank canvas and say so on screen.
NEXT_PUBLIC_PMTILES_URL=

# ---- seed ----
SEED_DEMO_PASSWORD=milan2026

# ---- demo controls ----
DEMO_MODE=true
CLOCK_OFFSET_DAYS=0
CRON_SECRET=offline-demo-cron-secret
