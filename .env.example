# Copy to .env.local and fill in. Never commit .env.local.

# ---- database ----
DATABASE_URL=            # transaction pooler (6543), app runtime
DIRECT_URL=              # session pooler (5432), migrations only
# Connections per instance. NEVER set this to 1: drizzle's postgres-js driver
# cannot pipeline, so two concurrent queries on one connection deadlock and take
# the whole instance with them. See lib/db/index.ts.
DATABASE_POOL_MAX=8

# ---- supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- storage (optional S3 / MinIO backend) ----
# When NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are absent, object
# storage falls back to an S3-compatible backend (e.g. MinIO) if these are set.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=media
# S3_PUBLIC_URL is optional; defaults to S3_ENDPOINT/S3_BUCKET.

# ---- auth ----
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---- intelligence ----
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER_CHAIN=gemini,groq,rules   # never remove 'rules'
# OLLAMA_BASE_URL intentionally absent: local inference is a declared future
# stub; nothing in the app reads it. The offline demo runs on the rules tier.

# ---- notifications ----
RESEND_API_KEY=
NOTIFY_FROM=milan@yourdomain.dev
SMS_MODE=mock                          # never anything else

# ---- map ----
# Public URL of a Jharkhand Protomaps .pmtiles extract. Unset is safe: the map
# falls back to drawing markers on a blank canvas and says so on screen.
NEXT_PUBLIC_PMTILES_URL=

# ---- seed ----
SEED_DEMO_PASSWORD=milan2026

# ---- demo controls ----
DEMO_MODE=true
CLOCK_OFFSET_DAYS=0
CRON_SECRET=
